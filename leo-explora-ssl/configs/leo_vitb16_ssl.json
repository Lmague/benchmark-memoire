{
  "_comment": "ExPLoRA SSL SimDINOv2-B -> tuiles Léo web (4 sites, stretchées, canoniques). ~355k tuiles 224px.",
  "tiles_dir": "$SCRATCH/web/tiles",
  "manifest": [
    "$SCRATCH/web/manifest_clairiere.json",
    "$SCRATCH/web/manifest_maison.json",
    "$SCRATCH/web/manifest_trail.json",
    "$SCRATCH/web/manifest_rousseau.json"
  ],
  "site_subdir": true,
  "simdinov2_ckpt": "$SCRATCH/checkpoints/simdinov2_vitb_inat21plantae.pth",
  "out_dir": "$SCRATCH/leo_ssl/runs/leo_vitb16_ssl",
  "seed": 0,
  "epochs": 50,
  "save_every_epochs": 5,
  "batch": 128,
  "workers": 8,
  "n_global": 2,
  "n_local": 6,
  "green_upsample": 1.0,
  "lora_r": 16,
  "lora_alpha": 16.0,
  "n_full_blocks": 2,
  "head_dim": 16384,
  "lr_lora": 0.0001,
  "lr_late": 0.00005,
  "lr_norm": 0.00001,
  "lr_head": 0.0001,
  "weight_decay": 0.05,
  "warmup_epochs": 3,
  "teacher_temp": 0.07,
  "ema_0": 0.996,
  "ema_1": 1.0,
  "w_ibot": 1.0,
  "w_koleo": 0.5,
  "log_every": 50
}
