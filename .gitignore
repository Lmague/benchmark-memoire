# .gitignore — dépôt CODE-SEUL (transport Colab).
# Stratégie liste blanche : tout ignorer par défaut, puis ré-inclure UNIQUEMENT
# le code transportable. Garantit que seuls src/, les 5 CLIs, configs/ et
# requirements.txt sont versionnés — aucune donnée / sortie / rapport ne fuit.

# 1) Tout ignorer à la racine…
/*

# 1b) …mais ré-inclure explicitement les sous-dossiers de résultats pour la repro.
!/results/
!/docs/figures/

# 2) …puis ré-inclure explicitement le code
!/src/
!/configs/
!/probe.py
!/extract.py
!/analyze.py
!/train.py
!/make_figures.py
!/requirements.txt
!/.gitignore

# 3) Caches Python toujours exclus, y compris sous src/ et configs/
__pycache__/
*.pyc
*.pyo

# --- Exclusions explicites (déjà couvertes par /* ci-dessus, rappelées pour intention) ---
# Données & sorties        : embeddings/ results/ results_v3/ out/ splits/
# Datasets & tuiles        : "Data for Early Detection .../"  "High-Resolution Arctic .../"  tiles/
# Artefacts lourds         : *.zip *.pdf *.npy *.pth
# Hors transport           : legacy/ notebooks/ scripts/ "After Training/" .claude/
# Utilitaires chemin absolu : validate_split.py  _gen_project_index.py

# Exception : transporter les scripts d'analyse (le reste de scripts/ reste ignoré)
!/scripts/
/scripts/*
!/scripts/bootstrap_ci.py
!/scripts/compute_correlations.py
!/scripts/significance_matrix.py
!/scripts/multiple_comparison.py
!/scripts/make_support_figures.py
!/scripts/geometry_extended.py
!/scripts/sample_efficiency.py
!/scripts/layerwise_probe.py
!/scripts/make_paper_figures.py
# Pipeline canonique A→F (passe nocturne 2) :
!/scripts/task_a_spectrum.py
!/scripts/task_b_logme.py
!/scripts/task_c_aso.py
!/scripts/task_c_b_paired.py
!/scripts/task_d_f1_corrected.py
!/scripts/gen_latex_tables.py
!/scripts/geometry_extended_12models.py
!/scripts/bootstrap_pair_only.py
!/scripts/run_pipeline.py
!/scripts/recompute_control_values.py
!/scripts/visualize_subsample.py
# Courbe de données Narval (Q5) :
!/scripts/datacurve_one_run.py
!/scripts/datacurve_aggregate.py
!/scripts/slurm_datacurve.sh
# SoTA screening baseline FT (4 régimes × 3 seeds) :
!/scripts/slurm_sota_screening.sh
# Probe corpus élargi (12 canoniques + 84 SOTA × 3 passes, CPU) :
!/scripts/slurm_probe_all.sh
# Bootstrap CI schéma 8cls (CPU) :
!/scripts/slurm_bootstrap_8cls.sh

# Dossier checkpoints : structure versionnée (.gitkeep), .pth exclus (trop lourds pour git)
!/checkpoints/
/checkpoints/*.pth

