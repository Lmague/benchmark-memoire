# .gitignore — dépôt CODE-SEUL (transport Colab).
# Stratégie liste blanche : tout ignorer par défaut, puis ré-inclure UNIQUEMENT
# le code transportable. Garantit que seuls src/, les 5 CLIs, configs/ et
# requirements.txt sont versionnés — aucune donnée / sortie / rapport ne fuit.

# 1) Tout ignorer à la racine…
/*

# 1b) …mais ré-inclure explicitement les sous-dossiers de résultats pour la repro.
!/docs/figures/

# 2) …puis ré-inclure explicitement le code
!/src/
!/configs/
!/probe.py
!/extract.py
!/analyze.py
!/train.py
!/make_figures.py
!/requirements.txt
!/.gitignore
!/paper_arctic_fm_benchmark/
!/tools/
/tools/*
!/tools/ortho_annotator/

# 2b) Courbe de données spatiale v2 (code + splits + manifest) — 2026-08-13.
#     Les CSV des splits sont requis sur Narval pour les runs LoRA spatiaux
#     (pipeline : datacurve_one_run.py lit csv_dir pointé par le script SLURM).
!/spatial_datacurve/

# 3) Caches Python toujours exclus, y compris sous src/ et configs/
__pycache__/
*.pyc
*.pyo

# --- Exclusions explicites (déjà couvertes par /* ci-dessus, rappelées pour intention) ---
# Données & sorties        : embeddings/ results/ results_v3/ out/ splits/
# Datasets & tuiles        : "Data for Early Detection .../"  "High-Resolution Arctic .../"  tiles/
# Artefacts lourds         : *.zip *.pdf *.npy *.pth
# Hors transport           : legacy/ notebooks/ scripts/ "After Training/" .claude/
# Utilitaires chemin absolu : validate_split.py  _gen_project_index.py

# --- Fichiers de résultats canoniques (reproduction du manuscrit) ---
# Relance2 (11cls + 8cls, source canonique unique du manuscript, corrélations n12 incluses)
!/results/relance2/
# Métriques latentes et corrélations
!/results/all_scores_consolidated.json
!/results/T2a_kmeans_control.json
# Paire phare canonique (T2.c)
!/results/T2c_headline_pair_p_CANONICAL.json

# --- Répertoires lourds NON commités (images, logs, runs intermédiaires) ---
# Les répertoires: figures/, figures_paper/, figures_support/,
#   datacurve/, overnight/, nightly_*, recompute_*, final_2026-07/,
#   layerwise/, reports/, transfer/
# restent ignorés par le catch-all /* — sauf les JSON individuels ci-dessous.

